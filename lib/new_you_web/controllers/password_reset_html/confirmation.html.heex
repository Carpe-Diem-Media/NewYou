<.auth_shell
  title={Copy.text!("confirm.title", @locale)}
  locale={@locale}
  heading_id="password-reset-heading"
>
  <script defer src={~p"/assets/js/password_reset.js"}>
  </script>
  <p id="reset-instructions" class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("confirm.body", @locale)}
  </p>
  <.form
    for={%{}}
    action="/password/reset/confirm"
    method="post"
    id="password-reset-confirmation"
    data-reset-form
    data-processing={Copy.text!("identity.password_reset.confirm.processing", @locale)}
    class="grid w-full max-w-prose gap-design-base justify-items-start"
  >
    <input type="hidden" name="proof" value={@proof} />
    <input type="hidden" name="locale" value={@locale} />
    <input type="hidden" name="operation_id" value={@operation_id} />
    <label class="text-design-body-sm font-design-bold" for="password">{Copy.text!(
      "identity.password_reset.confirm.password.label",
      @locale
    )}</label>
    <input
      class="min-h-design-input-height h-auto w-full rounded-design-sm border border-design-ink-muted bg-design-surface px-design-base py-design-sm text-design-body-sm leading-design-body-sm text-design-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
      id="password"
      name="password"
      type="password"
      required
      autocomplete="new-password"
      maxlength="1024"
      aria-describedby="reset-instructions"
    />
    <.primary_button type="submit" adaptive>{Copy.text!("confirm.action", @locale)}</.primary_button>
  </.form>
  <a
    href={"/login?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-xs leading-design-body-xs text-design-ink underline decoration-design-primary underline-offset-4 hover:text-design-primary active:text-design-primary-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{Copy.text!("identity.password_reset.navigation.back_to_login", @locale)}</a>
</.auth_shell>
