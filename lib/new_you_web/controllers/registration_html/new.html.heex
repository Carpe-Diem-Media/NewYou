<main id="main" class="registration-page ds-production-page" data-design-pilot="registration">
  <header class="ds-container ds-row ds-registration-header">
    <p>{NewYou.platform_name()}</p>
    <nav aria-label={copy("shared.language.change", @locale)} class="ds-row">
      <.text_link
        lang="af"
        href="/register?locale=af"
        aria-current={if @locale == "af", do: "page"}
      >
        {copy("shared.language.afrikaans", @locale)}
      </.text_link>
      <.text_link
        lang="en"
        href="/register?locale=en"
        aria-current={if @locale == "en", do: "page"}
      >
        {copy("shared.language.english", @locale)}
      </.text_link>
    </nav>
  </header>
  <div class="ds-container ds-stack ds-registration-content">
    <div class="ds-registration-intro ds-auto-grid">
      <h1 id="launch-heading" class="ds-registration-heading">
        {copy("public.entry.launch.title", @locale)}
      </h1>
      <p>{copy("public.entry.launch.body", @locale)}</p>
    </div>
    <section class="ds-registration-safety">
      <p>{copy("public.entry.safety.body", @locale)}</p>
    </section>
    <.design_card
      id="registration"
      heading_id="registration-heading"
      heading_level={2}
      title={copy("identity.registration.title", @locale)}
      aria-labelledby="registration-heading"
    >
      <:leading><.design_icon name="hero-user-circle" /></:leading>
      <p>{copy("identity.registration.intro", @locale)}</p>
      <.form
        for={@form}
        action={~p"/register"}
        method="post"
        id="registration-form"
        class="ds-registration-form ds-auto-grid"
      >
        <input type="hidden" name="registration[operation_id]" value={@operation_id} />

        <%= if @global_error do %>
          <p
            role="alert"
            class="ds-field-error ds-registration-wide"
          >
            {copy(@global_error, @locale)}
          </p>
        <% end %>

        <.design_field
          id="registration-first-name"
          name="registration[first_name]"
          type="text"
          label={copy("identity.registration.first_name.label", @locale)}
          error={@errors["first_name"] && copy(@errors["first_name"], @locale)}
          autocomplete="given-name"
          required
          value={Map.get(@values, "first_name", "")}
          autofocus={not is_nil(@errors["first_name"]) or not is_nil(@global_error)}
        />

        <.design_field
          id="registration-surname"
          name="registration[surname]"
          type="text"
          label={copy("identity.registration.surname.label", @locale)}
          error={@errors["surname"] && copy(@errors["surname"], @locale)}
          autocomplete="family-name"
          required
          value={Map.get(@values, "surname", "")}
        />

        <.design_field
          id="registration-email"
          name="registration[email]"
          type="email"
          label={copy("identity.registration.email.label", @locale)}
          error={@errors["email"] && copy(@errors["email"], @locale)}
          autocomplete="email"
          required
          value={Map.get(@values, "email", "")}
        />

        <.design_field
          id="registration-password"
          name="registration[password]"
          type="password"
          label={copy("identity.registration.password.label", @locale)}
          error={@errors["password"] && copy(@errors["password"], @locale)}
          autocomplete="new-password"
          required
        />

        <fieldset class="ds-design-field ds-registration-wide">
          <legend class="font-design-medium">
            {copy("identity.registration.preferred_language.label", @locale)}
          </legend>
          <p class="text-design-ink">
            {if @locale == "af",
              do: copy("shared.language.afrikaans", @locale),
              else: copy("shared.language.english", @locale)}
          </p>
          <input
            type="hidden"
            name="registration[preferred_language]"
            value={@locale}
            aria-describedby="preferred-language-help"
          />
          <p id="preferred-language-help" class="ds-note-text">
            {copy("identity.registration.preferred_language.help", @locale)}
          </p>
        </fieldset>

        <div class="ds-design-field ds-registration-wide">
          <label
            for="registration-age"
            class="ds-registration-check"
          >
            <input
              id="registration-age"
              type="checkbox"
              name="registration[confirmed_age_18]"
              value="true"
              checked={Map.get(@values, "confirmed_age_18") == "true"}
              required
              aria-required="true"
              aria-invalid={if @errors["confirmed_age_18"], do: "true"}
              aria-describedby={if @errors["confirmed_age_18"], do: "registration-age-error"}
              class="ds-registration-checkbox"
            />
            <span>{copy("identity.registration.age_confirmation", @locale)}</span>
          </label>
          <%= if @errors["confirmed_age_18"] do %>
            <p
              id="registration-age-error"
              role="alert"
              class="ds-field-error"
            >
              {copy(@errors["confirmed_age_18"], @locale)}
            </p>
          <% end %>
        </div>

        <div class="ds-registration-legal ds-registration-wide ds-stack">
          <p class="ds-note-text">
            {copy("legal.shared.document_language_disclosure", @locale)}
          </p>

          <div class="ds-design-field">
            <div class="ds-row">
              <label
                for="registration-terms"
                class="ds-registration-check"
              >
                <input
                  id="registration-terms"
                  type="checkbox"
                  name="registration[terms_accepted]"
                  value="true"
                  checked={Map.get(@values, "terms_accepted") == "true"}
                  required
                  aria-required="true"
                  aria-invalid={if @errors["terms_accepted"], do: "true"}
                  aria-describedby={if @errors["terms_accepted"], do: "registration-terms-error"}
                  class="ds-registration-checkbox"
                />
                <span>{copy("identity.registration.terms_acceptance", @locale)}</span>
              </label>
              <.text_link href="/legal/terms">
                {copy("identity.registration.terms_link", @locale)}
              </.text_link>
            </div>
            <%= if @errors["terms_accepted"] do %>
              <p
                id="registration-terms-error"
                role="alert"
                class="ds-field-error"
              >
                {copy(@errors["terms_accepted"], @locale)}
              </p>
            <% end %>
          </div>

          <div class="ds-stack border-t border-design-hairline pt-design-lg">
            <p class="ds-note-text">
              {copy("identity.registration.privacy_presentation", @locale)}
            </p>
            <.text_link href="/legal/privacy">
              {copy("identity.registration.privacy_link", @locale)}
            </.text_link>
            <label
              for="registration-privacy"
              class="ds-registration-check"
            >
              <input
                id="registration-privacy"
                type="checkbox"
                name="registration[privacy_accepted]"
                value="true"
                checked={Map.get(@values, "privacy_accepted") == "true"}
                required
                aria-required="true"
                aria-invalid={if @errors["privacy_accepted"], do: "true"}
                aria-describedby={
                  if @errors["privacy_accepted"], do: "registration-privacy-error"
                }
                class="ds-registration-checkbox"
              />
              <span>{copy("identity.registration.privacy_acceptance", @locale)}</span>
            </label>
            <%= if @errors["privacy_accepted"] do %>
              <p
                id="registration-privacy-error"
                role="alert"
                class="ds-field-error"
              >
                {copy(@errors["privacy_accepted"], @locale)}
              </p>
            <% end %>
          </div>
        </div>

        <div class="ds-registration-submit">
          <.primary_button id="registration-submit" type="submit" treatment="lit">
            {copy("identity.registration.submit", @locale)}
          </.primary_button>
        </div>
      </.form>
    </.design_card>
  </div>
</main>
