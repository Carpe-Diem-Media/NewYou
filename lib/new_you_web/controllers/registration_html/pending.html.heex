<main id="main" class="registration-page min-h-svh bg-ny-paper text-ny-copy">
  <header class="mx-auto flex w-full max-w-7xl flex-col gap-5 border-b border-ny-rule px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-10">
    <p class="font-ny-display text-lg font-semibold tracking-tight text-ny-ink">
      {NewYou.platform_name()}
    </p>
  </header>

  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-y-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-14 lg:px-10 lg:py-20">
    <section aria-labelledby="pending-heading" class="grid content-start gap-6 lg:col-span-7">
      <h1
        id="pending-heading"
        class="max-w-3xl font-ny-display text-4xl font-semibold leading-tight tracking-tight text-ny-ink sm:text-5xl lg:text-ny-display"
      >
        {copy("identity.verification.pending.title", @locale)}
      </h1>
      <p class="max-w-prose text-lg leading-relaxed text-ny-copy">
        {copy("identity.verification.pending.explanation", @locale)}
      </p>
      <p class="max-w-prose text-base leading-relaxed text-ny-copy">
        {copy("identity.verification.pending.check_inbox", @locale)}
      </p>
      <div class="grid gap-2 border-l-2 border-ny-rule-strong pl-4">
        <p class="text-sm font-semibold text-ny-ink">
          {copy("identity.verification.pending.address_label", @locale)}
        </p>
        <p class="break-words text-base leading-relaxed text-ny-ink">{@email}</p>
      </div>
      <%= if @registration_notice do %>
        <p
          role="status"
          class="border-l-2 border-ny-accent px-4 py-2 text-sm leading-relaxed text-ny-ink"
        >
          {copy(@registration_notice, @locale)}
        </p>
      <% end %>
      <%= if @resend_notice do %>
        <p
          role="status"
          class="border-l-2 border-ny-accent px-4 py-2 text-sm leading-relaxed text-ny-ink"
        >
          {copy(@resend_notice, @locale)}
        </p>
      <% end %>
    </section>

    <section
      aria-labelledby="resend-heading"
      class="grid content-start gap-6 border-t-2 border-ny-rule-strong pt-6 lg:col-span-4 lg:col-start-9 lg:mt-8 lg:pt-7"
    >
      <h2
        id="resend-heading"
        class="font-ny-display text-2xl font-semibold leading-tight tracking-tight text-ny-ink sm:text-3xl"
      >
        {copy("identity.verification.pending.not_arrived.title", @locale)}
      </h2>
      <p class="max-w-prose text-base leading-relaxed text-ny-copy">
        {copy("identity.verification.pending.not_arrived.body", @locale)}
      </p>

      <.form
        for={@resend_form}
        action={~p"/verification/resend"}
        method="post"
        id="verification-resend-form"
        class="grid gap-4"
      >
        <input type="hidden" name="resend[operation_id]" value={@resend_operation_id} />
        <input type="hidden" name="resend[preferred_language]" value={@locale} />
        <input type="hidden" name="resend[email]" value={@email} />
        <button
          type="submit"
          class="min-h-12 w-full justify-self-start whitespace-nowrap bg-ny-accent px-6 py-3 text-base font-semibold text-ny-accent-ink underline-offset-4 hover:bg-ny-accent-strong active:bg-ny-accent-strong disabled:bg-ny-muted disabled:text-ny-paper disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ny-focus sm:w-auto"
        >
          {copy("identity.verification.resend.action", @locale)}
        </button>
      </.form>

      <p class="max-w-prose text-sm leading-relaxed text-ny-copy">
        {copy("identity.verification.pending.access_limitation", @locale)}
      </p>
      <div class="flex flex-wrap gap-x-5 gap-y-2 border-t border-ny-rule pt-5">
        <a
          href={"/register?locale=#{@locale}"}
          class="min-h-11 content-center whitespace-nowrap text-sm text-ny-ink underline decoration-ny-accent underline-offset-4 hover:text-ny-accent active:text-ny-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ny-focus"
        >
          {copy("identity.verification.pending.browse_public", @locale)}
        </a>
        <a
          href="/register"
          class="min-h-11 content-center whitespace-nowrap text-sm text-ny-ink underline decoration-ny-accent underline-offset-4 hover:text-ny-accent active:text-ny-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ny-focus"
        >
          {copy("identity.verification.pending.home", @locale)}
        </a>
      </div>
    </section>
  </div>
</main>
