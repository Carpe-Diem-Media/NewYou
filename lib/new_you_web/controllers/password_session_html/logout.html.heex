<.auth_shell
  title={
    Copy.text!(
      if(@confirmed?,
        do: "identity.session.logout.confirmed.title",
        else: "identity.session.logout.uncertain.body"
      ),
      @locale
    )
  }
  locale={@locale}
>
  <p
    :if={@confirmed?}
    role="status"
    class="max-w-prose text-design-body-sm leading-design-body-sm"
  >
    {Copy.text!("identity.session.logout.confirmed.body", @locale)}
  </p>
  <.form
    :if={!@confirmed?}
    for={%{}}
    action="/session/logout"
    method="post"
    id="logout-retry"
    class="grid gap-design-base justify-items-start"
  >
    <input type="hidden" name="locale" value={@locale} />
    <.primary_button type="submit">{Copy.text!("identity.session.logout.retry", @locale)}</.primary_button>
  </.form>
  <a
    href={"/login?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-xs leading-design-body-xs text-design-ink underline decoration-design-primary underline-offset-4 hover:text-design-primary active:text-design-primary-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{Copy.text!(
    "identity.login.reauthenticate.action",
    @locale
  )}</a>
</.auth_shell>
