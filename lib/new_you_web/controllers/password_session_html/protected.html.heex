<.auth_shell
  title={Copy.text!("identity.session.protected.title", @locale)}
  locale={@locale}
  locale_path="/session/protected"
>
  <p role="status" class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.session.protected.status", @locale)}
  </p>
  <p class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.session.protected.body", @locale)}
  </p>
  <a
    :if={@email_change_copy}
    href={"/primary-email-change?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-sm underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{@email_change_copy}</a>
  <.form
    for={%{}}
    action="/session/logout"
    method="post"
    id="session-logout"
    class="grid gap-design-base justify-items-start"
  >
    <input type="hidden" name="locale" value={@locale} />
    <.primary_button type="submit">{Copy.text!("shared.navigation.logout", @locale)}</.primary_button>
  </.form>
</.auth_shell>
