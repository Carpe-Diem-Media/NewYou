<.auth_shell
  title={Copy.text!("identity.session.protected.title", @locale)}
  locale={@locale}
  locale_path="/session/protected"
>
  <p role="status" class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.session.protected.status", @locale)}
  </p>
  <p class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.session.protected.body", @locale)}
  </p>
  <% reference_copy = member_reference_copy(@locale) %>
  <script defer src={~p"/assets/js/member_reference.js"}>
  </script>
  <div class="grid min-w-0 gap-design-base justify-items-start">
    <dl class="min-w-0 max-w-full text-design-body-sm leading-design-body-sm">
      <dt id="member-reference-label" class="font-design-bold">{reference_copy.label}</dt>
      <dd id="member-reference-value" class="break-all">{@pmr}</dd>
    </dl>
    <.secondary_button
      id="copy-member-reference"
      type="button"
      hidden
      data-copied={reference_copy.copied}
      data-unavailable={reference_copy.unavailable}
    >
      {reference_copy.action}
    </.secondary_button>
    <p id="member-reference-copy-status" role="status" class="text-design-body-sm"></p>
  </div>
  <a
    :if={@email_change_copy}
    href={"/primary-email-change?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-sm underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{@email_change_copy}</a>
  <a
    :if={@session_management_title}
    href={"/session/manage?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-sm underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{@session_management_title}</a>
  <.form
    for={%{}}
    action="/session/logout"
    method="post"
    id="session-logout"
    class="grid gap-design-base justify-items-start"
  >
    <input type="hidden" name="locale" value={@locale} />
    <.primary_button type="submit">{Copy.text!("shared.navigation.logout", @locale)}</.primary_button>
  </.form>
</.auth_shell>
