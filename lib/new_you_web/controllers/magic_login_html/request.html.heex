<.auth_shell
  title={Copy.text!("identity.magic.request.title", @locale)}
  locale={@locale}
  locale_path="/login/magic"
  heading_id="magic-login-heading"
>
  <p class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.magic.request.body", @locale)}
  </p>
  <.form
    for={%{}}
    action="/login/magic"
    method="post"
    id="magic-login-request"
    class="grid w-full max-w-prose gap-design-base justify-items-start"
  >
    <input type="hidden" name="locale" value={@locale} />
    <input type="hidden" name="operation_id" value={@operation_id} />
    <label class="text-design-body-sm font-design-bold" for="email">{Copy.text!(
      "identity.login.email.label",
      @locale
    )}</label>
    <input
      class="h-design-input-height w-full rounded-design-sm border border-design-ink-muted bg-design-surface px-design-base py-design-sm text-design-body-sm text-design-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
      id="email"
      name="email"
      type="email"
      required
      autocomplete="username"
    />
    <.primary_button type="submit">{Copy.text!("identity.magic.request.action", @locale)}</.primary_button>
  </.form>
  <a
    href={"/login?locale=#{@locale}"}
    class="min-h-11 w-fit content-center text-design-body-xs leading-design-body-xs text-design-ink underline decoration-design-primary underline-offset-4 hover:text-design-primary active:text-design-primary-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-design-primary"
  >{Copy.text!(
    "identity.login.reauthenticate.action",
    @locale
  )}</a>
</.auth_shell>
