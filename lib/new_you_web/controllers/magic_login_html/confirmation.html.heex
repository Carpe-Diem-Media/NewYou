<.auth_shell
  title={Copy.text!("identity.magic.confirm.title", @locale)}
  locale={@locale}
  heading_id="magic-login-heading"
>
  <p class="max-w-prose text-design-body-sm leading-design-body-sm">
    {Copy.text!("identity.magic.confirm.body", @locale)}
  </p>
  <.form
    for={%{}}
    action="/login/magic/confirm"
    method="post"
    id="magic-login-confirmation"
    class="grid gap-design-base justify-items-start"
  >
    <input type="hidden" name="proof" value={@proof} />
    <input type="hidden" name="locale" value={@locale} />
    <.primary_button type="submit">{Copy.text!("identity.magic.confirm.action", @locale)}</.primary_button>
  </.form>
</.auth_shell>
