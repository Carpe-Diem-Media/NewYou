  ],
  "request_flow": [
    {
      "summary": "Commerce accepts the verified canonical Account for one R399 Plan version and attempt.",
      "source_ids": [
        "commerce",
        "identity",
        "purchase"
      ]
    },
    {
      "summary": "Commerce qualifies evidence, locks the purchase and commits verified payment and the open obligation.",
      "source_ids": [
        "commerce",
        "payment",
        "consequence"
      ]
    },
    {
      "summary": "Entitlements applies the original source in its own transaction. Commerce then acknowledges the obligation.",
      "source_ids": [
        "commerce",
        "entitlements",
        "right"
      ]
    }
  ],
  "lifecycle": {
    "states": [
      "unaccepted",
      "accepted_pending",
      "verified_open",
      "held_open",
      "held_fulfilled"
    ],
    "transitions": [
      {
        "from_state": "unaccepted",
        "to_state": "accepted_pending",
        "guards": [
          "Canonical Account and exact synthetic version."
        ],
        "side_effects": [
          "Persist the immutable purchase and attempt."
        ],
        "terminal": false,
        "source_ids": [
          "commerce",
          "purchase",
          "identity"
        ]
      },
      {
        "from_state": "accepted_pending",
        "to_state": "verified_open",
        "guards": [
          "Qualified evidence matches the locked attempt."
        ],
        "side_effects": [
          "Commit payment and open consequence atomically."
        ],
        "terminal": false,
        "source_ids": [
          "commerce",
          "payment",
          "consequence"
        ]
      },
      {
        "from_state": "verified_open",
        "to_state": "held_open",
        "guards": [
          "Committed consequence matches payment, purchase and recipient."
        ],
        "side_effects": [
          "Commit one held Plan right."
        ],
        "terminal": false,
        "source_ids": [
          "commerce",
          "entitlements",
          "right"
        ]
      },
      {
        "from_state": "held_open",
        "to_state": "held_fulfilled",
        "guards": [
          "Original right has committed or replayed."
        ],
        "side_effects": [
          "Acknowledge the consequence and keep the right held."
        ],
        "terminal": true,
        "source_ids": [
          "commerce",
          "entitlements",
          "consequence"
        ]
      }
    ]
  },
  "security_invariants": [
    {
      "summary": "Only a current canonical recipient session can read rights. Direct Ash grants and reads are denied.",
      "source_ids": [
        "right",
        "identity",
        "entitlements"
      ]
    },
    {
      "summary": "Production excludes the producer and synthetic acceptance and application paths.",
      "source_ids": [
        "fixture",
        "production",
        "commerce"
      ]
    },
    {
      "summary": "Identity checks exact owner registration and rechecks bound results. Both new owners support only empty scope.",
      "source_ids": [
        "review",
        "commerce",
        "entitlements"
      ]
    }
  ],
  "concurrency": [
    {
      "summary": "Independent SQL calls wait on the purchase row. Unique identities bind the payment, consequence and component right.",
      "source_ids": [
        "cases",
        "commerce",
        "payment",
        "right"
      ]
    }
  ],
  "idempotency_retry": [
    {
      "summary": "Replay preserves the attempt, verified payment, right and first acknowledgement time.",
      "source_ids": [
        "commerce",
        "purchase",
        "right",
        "cases"
      ]
    }
  ],
  "failure_recovery": [
    {
      "summary": "Rollback leaves a pending attempt. AshOban can rediscover an open consequence after either committed cut.",
      "source_ids": [
        "commerce",
        "consequence",
        "cases",
        "restart"
      ]
    }
  ],
  "tests": [
    {
      "path": "test/new_you/commerce/plan_payment_test.exs",
      "cases": [
        "P1-01",
        "P1-02",
        "P1-03",
        "P1-04",
        "P1-05"
      ],
      "proves": "Admission, forged input denial, real SQL contention, rollback and fresh recovery through the generated worker.",
      "limits": "Synthetic only.",
      "source_ids": [
        "cases",
        "restart"
      ]
    },
    {
      "path": "test/proof/well189_plan_payment_production.exs",
      "cases": [
        "P1-06"
      ],
      "proves": "Production BEAM excludes fixture and rejects raw evidence.",
      "limits": "Run against production build.",
      "source_ids": [
        "production",
        "commerce"
      ]
    },
    {
      "path": "test/new_you/identity/reconciliation_test.exs",
      "cases": [
        "P1-07"
      ],
      "proves": "Empty scope approval and replay, unknown and absent owners, stale review after separate commit, and fresh conflict denial.",
      "limits": "Empty-scope owners only.",
      "source_ids": [
        "identity_cases",
        "review"
      ]
    }
  ],
  "safe_extensions": [
    {
      "summary": "Offers, provider verification, corrections and delivery each require their approved owner contract.",
      "source_ids": [
        "commerce",
        "entitlements"
      ]
    }
  ],
  "reuse": [
    {
      "summary": "Reused Identity session authorization and AshOban rediscovery. Adapted Store patterns for immutable snapshots, SQL arbitration and exact-source grants.",
      "source_ids": [
        "identity",
        "commerce",
        "consequence",
        "right"
      ]
    }
  ],
  "prohibited_shortcuts": [
    {
      "summary": "No raw business writes, provider fixture entry points, right reassignment or process-local authority.",
      "source_ids": [
        "commerce",
        "entitlements",
        "review"
      ]
    }
  ],
  "proof_limitations": [
    "One synthetic R399 Plan only. Provider, public checkout, production release, Plan delivery and consumption remain outside this proof."
  ],
  "follow_up_tickets": [
    "WELL-190",
    "WELL-192",
    "WELL-197"
  ],
