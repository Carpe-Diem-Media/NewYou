{
  "schema_version": 1,
  "capability_id": "commerce.synthetic_plan_payment",
  "purpose": "Prove that one synthetic accepted Plan payment creates one held right for its verified payer and recipient.",
  "implementing_tickets": [
    "WELL-189"
  ],
  "implementation_revision": {
    "git_sha": "d2dc4fee1120051d756a4070e4b0f19da0f97dbf",
    "semantics": "Bounded FP-002 P1 covers ownership and recovery from acceptance to the held right."
  },
  "authoritative_domain": "NewYou.Commerce",
  "collaborating_domains": [
    {
      "domain": "NewYou.Entitlements",
      "interface": "grant_paid_plan/1 and plan_rights/1",
      "ownership": "Owns the source-bound Plan right.",
      "source_ids": [
        "entitlements",
        "right"
      ]
    },
    {
      "domain": "NewYou.Identity",
      "interface": "authorize_canonical_session/1 and owner_reviews/1",
      "ownership": "Owns canonical Account eligibility and reconciliation.",
      "source_ids": [
        "identity",
        "review"
      ]
    }
  ],
  "ash": [
    {
      "domain": "NewYou.Commerce",
      "resource": "NewYou.Commerce.Purchase",
      "actions": [
        "read",
        "accept"
      ],
      "caller_boundary": "Commerce admission holds the canonical Account lock.",
      "source_ids": [
        "purchase"
      ]
    },
    {
      "domain": "NewYou.Commerce",
      "resource": "NewYou.Commerce.VerifiedPayment",
      "actions": [
        "read",
        "apply"
      ],
      "caller_boundary": "Commerce applies qualified evidence under the purchase lock.",
      "source_ids": [
        "payment"
      ]
    },
    {
      "domain": "NewYou.Commerce",
      "resource": "NewYou.Commerce.PaymentConsequence",
      "actions": [
        "read",
        "establish",
        "deliver",
        "acknowledge"
      ],
      "caller_boundary": "Commerce establishes and acknowledges. AshOban rediscovers and delivers.",
      "source_ids": [
        "consequence"
      ]
    },
    {
      "domain": "NewYou.Entitlements",
      "resource": "NewYou.Entitlements.PlanRight",
      "actions": [
        "read",
        "grant"
      ],
      "caller_boundary": "Private actions require the paid source or current recipient.",
      "source_ids": [
        "right"
      ]
    }
  ],
  "interfaces": [
    {
      "module": "NewYou.Commerce",
      "function": "accept_plan_purchase",
      "arity": 2,
      "visibility": "internal",
      "arguments": [
        "Current Identity Session credentials.",
        "Operation UUID and synthetic-plan-v1."
      ],
      "returns": [
        "Immutable Purchase or purchase_unavailable."
      ],
      "side_effects": [
        "Establishes one accepted snapshot and attempt."
      ],
      "caller_constraints": [
        "TEST-only admission."
      ],
      "source_ids": [
        "commerce",
        "purchase",
        "identity"
      ]
    },
    {
      "module": "NewYou.Commerce",
      "function": "apply_payment_observation",
      "arity": 1,
      "visibility": "internal",
      "arguments": [
        "Qualified synthetic observation with exact purchase, attempt, amount, currency, environment, integration and status."
      ],
      "returns": [
        "VerifiedPayment or payment_unavailable."
      ],
      "side_effects": [
        "Atomically commits payment and consequence."
      ],
      "caller_constraints": [
        "TEST-only application."
      ],
      "source_ids": [
        "commerce",
        "fixture",
        "payment",
        "consequence"
      ]
    },
    {
      "module": "NewYou.Commerce",
      "function": "deliver_plan_payment_consequence",
      "arity": 1,
      "visibility": "internal",
      "arguments": [
        "Durable consequence UUID."
      ],
      "returns": [
        "Held PlanRight or delivery_unavailable."
      ],
      "side_effects": [
        "Replays or grants the right and acknowledges the consequence."
      ],
      "caller_constraints": [
        "Use outside any enclosing transaction."
      ],
      "source_ids": [
        "commerce",
        "entitlements",
        "consequence",
        "worker"
      ]
    },
    {
      "module": "NewYou.Entitlements",
      "function": "plan_rights",
      "arity": 1,
      "visibility": "internal",
      "arguments": [
        "Current canonical Account Session credentials."
      ],
      "returns": [
        "Held PlanRights for the recipient or rights_unavailable."
      ],
      "side_effects": [
        "Touches the current Session and reads owned rights."
      ],
      "caller_constraints": [
        "Provides no delivered-content authorization."
      ],
      "source_ids": [
        "entitlements",
        "identity",
        "right"
      ]
    }
  ],
