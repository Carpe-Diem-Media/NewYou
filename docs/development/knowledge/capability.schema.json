{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Carpe-Diem-Media/NewYou/capability.schema.json",
  "title": "NewYou descriptive capability map v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "implementing_tickets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^WELL-[1-9][0-9]*$"
      },
      "minItems": 1
    },
    "implementation_revision": {
      "type": "object",
      "properties": {
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "git_sha",
        "semantics"
      ],
      "additionalProperties": false
    },
    "authoritative_domain": {
      "type": "string",
      "minLength": 1
    },
    "collaborating_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "interface": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "domain",
          "interface",
          "ownership",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "ash": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "caller_boundary": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "domain",
          "resource",
          "actions",
          "caller_boundary",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "arity": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "supported",
              "internal"
            ]
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "returns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "caller_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "module",
          "function",
          "arity",
          "visibility",
          "arguments",
          "returns",
          "side_effects",
          "caller_constraints",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "migration": {
            "type": "string",
            "minLength": 1
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "migration",
          "tables",
          "constraints",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "request_flow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_state": {
                "type": "string",
                "minLength": 1
              },
              "to_state": {
                "type": "string",
                "minLength": 1
              },
              "guards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "side_effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "terminal": {
                "type": "boolean"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "from_state",
              "to_state",
              "guards",
              "side_effects",
              "terminal",
              "source_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "security_invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "concurrency": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "idempotency_retry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "failure_recovery": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "proves": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "path",
          "cases",
          "proves",
          "limits",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "safe_extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "reuse": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "prohibited_shortcuts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "proof_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "follow_up_tickets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "symbol",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "purpose",
    "implementing_tickets",
    "implementation_revision",
    "authoritative_domain",
    "collaborating_domains",
    "ash",
    "interfaces",
    "persistence",
    "request_flow",
    "lifecycle",
    "security_invariants",
    "concurrency",
    "idempotency_retry",
    "failure_recovery",
    "tests",
    "safe_extensions",
    "reuse",
    "prohibited_shortcuts",
    "proof_limitations",
    "follow_up_tickets",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "summary",
        "source_ids"
      ],
      "additionalProperties": false
    }
  }
}
