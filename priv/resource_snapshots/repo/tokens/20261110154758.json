        "recovery_case_id"
      ],
      "base_filter": null,
      "check": "(recovery_case_id IS NULL AND recovery_claims IS NULL AND purpose NOT IN ('recovery','recovery_consumed','recovery_revoked')) OR (recovery_case_id IS NOT NULL AND recovery_claims IS NOT NULL AND purpose IN ('recovery','recovery_consumed','recovery_revoked','revocation') AND recovery_claims->>'purpose' = 'recovery' AND recovery_claims->>'jti' = jti AND recovery_claims->>'sub' = subject AND recovery_claims->>'case_id' = recovery_case_id::text)",
      "name": "tokens_recovery_metadata"
    },
    {
      "attribute": [
        "reset_request_id"
      ],
      "base_filter": null,
      "check": "(purpose NOT IN ('password_reset', 'password_reset_superseded', 'password_reset_consumed') AND reset_request_id IS NULL AND reset_claims IS NULL AND reset_account_binding IS NULL AND reset_locale IS NULL AND reset_consumption_id IS NULL) OR (reset_request_id IS NOT NULL AND reset_claims IS NOT NULL AND reset_locale IS NOT NULL AND reset_locale IN ('en', 'af') AND ((purpose = 'password_reset_consumed' AND reset_consumption_id IS NOT NULL AND reset_account_binding IS NULL) OR (purpose <> 'password_reset_consumed' AND reset_consumption_id IS NULL AND reset_account_binding IS NOT NULL)))",
      "name": "tokens_password_reset_metadata"
    },
