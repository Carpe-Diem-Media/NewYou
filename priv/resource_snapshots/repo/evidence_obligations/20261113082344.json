      "check": "evidence_type IN ('account_registration_pmr_assignment', 'security_hold_placement', 'security_hold_review', 'security_hold_release_result', 'identity_mfa_confirmed', 'identity_grant_revoked', 'identity_reconciliation_result', 'identity_reconciliation_review', 'identity_password_reset', 'identity_recovery_completed', 'identity_recovery_review', 'identity_primary_email_change_requested', 'identity_primary_email_change_confirmed', 'identity_primary_email_change_applied', 'identity_primary_email_change_cancelled', 'identity_primary_email_change_expired', 'identity_primary_email_change_rejected', 'identity_primary_email_change_superseded', 'identity_primary_email_change_held', 'identity_primary_email_change_reviewed')",
